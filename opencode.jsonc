{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "snapshot": true,
  "permission": {
    "edit": {
      "*": "allow",
      "data/*.db*": "deny",
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "git push*": "ask",
    },
  },
  "agent": {
    "explore": {
      "model": "deepseek/deepseek-flash",
      "steps": 30,
    },
    "build": {
      "steps": 50,
    },
  },
  "plugins": ["opencode-skills"],
  "experimental": {
    "exposeSkillsAsCommands": true
  }
}
